<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= author.username %> - DevBlog
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="logo">DevBlog</a>
            <div class="nav-links">
                <a href="/">Posts</a>
                <% if (userId) { %>
                    <a href="/logout">Logout</a>
                    <% } else { %>
                        <a href="/login">Login</a>
                        <a href="/signup">Sign Up</a>
                        <% } %>
            </div>
        </div>
    </nav>

    <main class="container">
        <a href="/" class="back-link">← Back to All Posts</a>

        <div class="page-header">
            <div>
                <h1>Posts by <%= author.username %>
                </h1>
                <p class="note-meta">Member since <%= new Date(author.created_at).toLocaleDateString() %> • <%=
                            posts.length %> post(s)</p>
            </div>
        </div>

        <% if (posts.length===0) { %>
            <div class="empty">This author hasn't published any posts yet.</div>
            <% } else { %>
                <div class="notes-list">
                    <% posts.forEach(post=> { %>
                        <div class="note">
                            <div class="note-header">
                                <a href="/posts/<%= post.id %>" class="note-title">
                                    <%= post.title %>
                                </a>
                                <% if (userId===post.author_id) { %>
                                    <div class="note-actions">
                                        <a href="/posts/<%= post.id %>/edit" class="action-btn">Edit</a>
                                        <form action="/posts/<%= post.id %>/delete" method="POST">
                                            <button type="submit" class="action-btn delete-btn">Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>
                            <p class="note-content">
                                <%= post.content.length> 200 ? post.content.substring(0, 200) + '...' : post.content %>
                            </p>
                            <div class="note-meta">
                                <span>
                                    <%= new Date(post.created_at).toLocaleDateString() %>
                                </span>
                                <% if (post.category_name) { %>
                                    <span>•</span>
                                    <span>
                                        <%= post.category_name %>
                                    </span>
                                    <% } %>
                                        <% if (post.tags && post.tags.length> 0) { %>
                                            <span>•</span>
                                            <div class="tag-selector">
                                                <% post.tags.forEach(t=> { %>
                                                    <a href="/?tag=<%= t %>" class="tag-option"
                                                        style="padding: 2px 8px; font-size: 11px;">#<%= t %></a>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </main>
</body>

</html>