<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Post - DevBlog</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="logo">DevBlog</a>
            <div class="nav-links">
                <a href="/">Posts</a>
                <a href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="form-page">
            <a href="/posts/<%= post.id %>" class="back-link">← Back to Post</a>
            <h1>Edit Post</h1>

            <form action="/posts/<%= post.id %>/edit" method="POST" class="note-form">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" value="<%= post.title %>" required>
                </div>

                <div class="form-group">
                    <label for="category_id">Category</label>
                    <select id="category_id" name="category_id">
                        <option value="">Select a category</option>
                        <% categories.forEach(cat=> { %>
                            <option value="<%= cat.id %>" <%=post.category_id===cat.id ? 'selected' : '' %>>
                                <%= cat.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="tags">Tags (comma-separated)</label>
                    <input type="text" id="tags" name="tags" value="<%= post.tags ? post.tags.join(', ') : '' %>">
                </div>

                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" name="content" required><%= post.content %></textarea>
                </div>

                <div class="form-actions">
                    <a href="/posts/<%= post.id %>" class="cancel-btn">Cancel</a>
                    <button type="submit" class="submit-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>