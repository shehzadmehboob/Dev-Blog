<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>New Post - DevBlog</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="logo">DevBlog</a>
            <div class="nav-links">
                <a href="/">Posts</a>
                <a href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="form-page">
            <a href="/" class="back-link">← Back to Posts</a>
            <h1>New Post</h1>

            <form action="/posts" method="POST" class="note-form">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" required>
                </div>

                <div class="form-group">
                    <label for="category_id">Category</label>
                    <select id="category_id" name="category_id">
                        <option value="">Select a category</option>
                        <% categories.forEach(cat=> { %>
                            <option value="<%= cat.id %>">
                                <%= cat.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="tags">Tags (comma-separated, e.g. nodejs, sql, express)</label>
                    <input type="text" id="tags" name="tags" placeholder="javascript, tutorial, api">
                </div>

                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" name="content" required></textarea>
                </div>

                <div class="form-actions">
                    <a href="/" class="cancel-btn">Cancel</a>
                    <button type="submit" class="submit-btn">Publish</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>